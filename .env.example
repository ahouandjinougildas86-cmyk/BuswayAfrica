# Copie ce fichier en .env.local et remplis avec les infos de ton projet Firebase
# (Console Firebase > Paramètres du projet > Général > Tes applications > Config SDK)
# Ce sont les MÊMES identifiants que ceux utilisés dans ton app Flutter Busway Africa,
# car l'admin doit lire/écrire dans le même projet Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
