rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction utilitaire : vérifie que l'utilisateur connecté a bien
    // un document dans "users" avec role == "admin"
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Collection "users" : chacun peut lire/écrire son propre document,
    // mais seul un admin peut lire les documents des autres (utile pour
    // vérifier les rôles) ou modifier le champ "role" de quelqu'un.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // Réservations : les clients créent leurs propres réservations depuis
    // l'app mobile, mais seul un admin peut tout lire/modifier depuis le
    // dashboard (changer un statut, annuler, etc.)
    match /reservations/{reservationId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Trajets : lecture publique (l'app mobile affiche les trajets
    // disponibles), mais seul l'admin peut créer/modifier/supprimer un trajet
    match /trajets/{trajetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Note : les chauffeurs n'ont pas de collection séparée — ils vivent
    // dans "users" avec role == "driver", déjà couvert par le bloc
    // /users/{userId} ci-dessus (l'admin peut lire/modifier leur statut).

    // Colis : lecture par l'admin ou les parties concernées, écriture
    // réservée à l'admin pour la mise à jour du statut de livraison
    match /parcels/{parcelId} {
      allow read: if isAdmin() ||
        (request.auth != null &&
         (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid));
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
  }
}
